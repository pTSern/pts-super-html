{
  "package_version": 2,
  "version": "1.0.0",
  "name": "pts-super-html",
  "description": "Next-generation single-file playable ads builder for Cocos Creator 3.8.8",
  "author": "pTS",
  "main": "./dist/main.js",
  "panels": {
    "default": {
      "title": "pTS Super HTML",
      "main": "./dist/panel/index.js",
      "flags": {
        "save": true
      },
      "size": {
        "min-width": 640,
        "min-height": 600,
        "width": 780,
        "height": 720
      }
    }
  },
  "contributions": {
    "asset-db": {
      "mount": {
        "path": "./assets/",
        "readonly": true
      }
    },
    "builder": "./dist/builder.js",
    "menu": [
      {
        "path": "i18n:menu.extension",
        "label": "pTS Super HTML",
        "message": "open-panel"
      }
    ],
    "messages": {
      "open-panel": {
        "methods": [
          "openPanel"
        ]
      },
      "build": {
        "methods": [
          "build"
        ]
      }
    },
    "panels": {
      "default": {
        "title": "pTS Super HTML",
        "main": "./dist/panel/index.js",
        "flags": {
          "save": true
        },
        "size": {
          "min-width": 640,
          "min-height": 600,
          "width": 780,
          "height": 720
        }
      }
    }
  },
  "editor": ">=3.4.0",
  "scripts": {
    "build": "tsc -p tsconfig.json && node dist/tools/build-runtime.js",
    "pack": "node dist/tools/pack-cli.js",
    "test": "npm run build && node dist/tests/codec.test.js && node dist/tests/pack.test.js"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@msgpack/msgpack": "^3.1.3",
    "fflate": "^0.8.3",
    "fonteditor-core": "^2.6.3",
    "jpeg-js": "^0.4.4",
    "jszip": "^3.10.1",
    "lamejs": "^1.2.1",
    "mpg123-decoder": "^1.0.3",
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.4",
    "upng-js": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/opentype.js": "^1.3.10",
    "@types/upng-js": "^2.1.5",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.2",
    "ws": "^8.21.3"
  }
}
